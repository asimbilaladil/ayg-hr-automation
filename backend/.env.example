# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/hr_system"

# ─── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-with-openssl-rand-hex-32-min-32-chars
ORG_EMAIL_DOMAIN=aygfoods.com

# ─── n8n / Vapi API Key ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
N8N_API_KEY=generate-a-long-random-secret-here-min-32-chars

# ─── Groq (onboarding review rating extraction) ─────────────────────────────────
# Get a key at https://console.groq.com
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b
GROQ_MODEL=

# ─── VAPI (onboarding call recording playback) ──────────────────────────────────
# Private API key from the VAPI dashboard — required to fetch call recordings
# server-side since VAPI's July 2026 auth change (recordingUrl is no longer
# directly downloadable). See: https://docs.vapi.ai/assistants/retrieve-call-artifacts
VAPI_PRIVATE_API_KEY=

# ─── App ────────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
